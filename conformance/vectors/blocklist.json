      "policy": {
        "blocklist": ["::ffff:203.0.113.0/120"],
        "allowlist": []
      },
      "request": {
        "method": "GET",
        "target": "/",
        "headers": [],
        "remoteAddress": "203.0.113.7"
      },
      "expect": {
        "outcome": "blocked",
        "status": 403
      }
    },
    {
      "name": "block-invalid-entries-ignored",
      "description": "Malformed entries are ignored, never widened (no lenient prefix parsing).",
      "config": {
        "mode": "enforce",
        "trustProxy": false,
        "allowlist": [],
        "decoys": [
          {
            "id": "web-admin-admin",
            "path": "/admin",
            "prefix": true
          },
          {
            "id": "web-bait-env",
            "path": "/.env",
            "prefix": false
          },
          {
            "id": "web-bait-backup-sql",
            "path": "/backup.sql",
            "prefix": false
          }
        ]
      },
      "policy": {
        "blocklist": ["not-an-ip", "203.0.113.0/33", "192.0.0.0/2x", "203.0.113.7/24/1", ""],
        "allowlist": []
      },
      "request": {
        "method": "GET",
        "target": "/",
        "headers": [],
        "remoteAddress": "203.0.113.7"
      },
      "expect": {
        "outcome": "pass_through"
