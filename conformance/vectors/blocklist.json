      "policy": {
        "blocklist": ["2001:DB8:0:0:0:0:0:7"],
        "allowlist": []
      },
      "request": {
        "method": "GET",
        "target": "/",
        "headers": [],
        "remoteAddress": "2001:db8::7"
      },
      "expect": {
        "outcome": "blocked",
        "status": 403
      }
    },
    {
      "name": "block-cidr-ipv6",
      "description": "IPv6 CIDRs.",
      "config": {
        "mode": "enforce",
        "trustProxy": false,
