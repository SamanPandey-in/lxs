{
  "$schema": "../schema/vector.schema.json",
  "category": "blocklist",
  "description": "Enforcing the policy blocklist: exact addresses and CIDRs, IPv4 and IPv6, compared on canonical addresses. Blocking happens before decoy routing; the response is a generic 403.",
  "vectors": [
    {
      "name": "block-exact-ipv4",
      "description": "A blocklisted address gets 403.",
      "config": {
        "mode": "enforce",
        "trustProxy": false,
        "allowlist": [],
        "decoys": [
          {
            "id": "web-admin-admin",
            "path": "/admin",
            "prefix": true
          },
          {
            "id": "web-bait-env",
            "path": "/.env",
            "prefix": false
          },
          {
            "id": "web-bait-backup-sql",
            "path": "/backup.sql",
            "prefix": false
          }
        ]
      },
      "policy": {
        "blocklist": ["203.0.113.7"],
        "allowlist": []
      },
      "request": {
        "method": "GET",
        "target": "/api/products",
        "headers": [],
        "remoteAddress": "203.0.113.7"
      },
      "expect": {
        "outcome": "blocked",
        "status": 403
      }
    },
    {
      "name": "block-cidr-ipv4",
      "description": "CIDR entries match their range.",
      "config": {
        "mode": "enforce",
        "trustProxy": false,
        "allowlist": [],
        "decoys": [
          {
            "id": "web-admin-admin",
            "path": "/admin",
            "prefix": true
          },
          {
            "id": "web-bait-env",
            "path": "/.env",
            "prefix": false
          },
          {
            "id": "web-bait-backup-sql",
            "path": "/backup.sql",
            "prefix": false
          }
        ]
      },
      "policy": {
        "blocklist": ["203.0.113.0/24"],
        "allowlist": []
      },
      "request": {
        "method": "GET",
        "target": "/api/products",
        "headers": [],
        "remoteAddress": "203.0.113.7"
      },
      "expect": {
        "outcome": "blocked",
        "status": 403
      }
    },
    {
      "name": "block-cidr-ipv4-outside",
      "description": "CIDR boundaries are exact.",
      "config": {
        "mode": "enforce",
        "trustProxy": false,
        "allowlist": [],
        "decoys": [
          {
            "id": "web-admin-admin",
            "path": "/admin",
            "prefix": true
          },
          {
            "id": "web-bait-env",
            "path": "/.env",
            "prefix": false
          },
          {
            "id": "web-bait-backup-sql",
            "path": "/backup.sql",
            "prefix": false
          }
        ]
      },
      "policy": {
        "blocklist": ["203.0.113.0/30"],
        "allowlist": []
      },
      "request": {
        "method": "GET",
        "target": "/api/products",
        "headers": [],
        "remoteAddress": "203.0.113.7"
      },
      "expect": {
        "outcome": "pass_through"
      }
    },
    {
      "name": "block-ipv6-noncanonical-entry",
      "description": "Entries are compared canonically, not as text.",
      "config": {
        "mode": "enforce",
        "trustProxy": false,
        "allowlist": [],
        "decoys": [
          {
            "id": "web-admin-admin",
            "path": "/admin",
            "prefix": true
          },
          {
            "id": "web-bait-env",
