    },
    {
      "name": "block-mapped-cidr",
      "description": "An IPv4-mapped CIDR (prefix >= 96) is the IPv4 CIDR with 96 fewer bits.",
      "config": {
        "mode": "enforce",
        "trustProxy": false,
        "allowlist": [],
        "decoys": [
          {
            "id": "web-admin-admin",
            "path": "/admin",
            "prefix": true
          },
          {
            "id": "web-bait-env",
            "path": "/.env",
            "prefix": false
