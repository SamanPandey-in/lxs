    {
      "name": "block-v4-cidr-not-v6",
      "description": "An IPv4 CIDR never matches an IPv6 client.",
      "config": {
        "mode": "enforce",
        "trustProxy": false,
        "allowlist": [],
        "decoys": [
          {
            "id": "web-admin-admin",
            "path": "/admin",
            "prefix": true
          },
          {
            "id": "web-bait-env",
            "path": "/.env",
            "prefix": false
          },
          {
            "id": "web-bait-backup-sql",
            "path": "/backup.sql",
            "prefix": false
          }
        ]
      },
      "policy": {
        "blocklist": ["0.0.0.0/1", "128.0.0.0/1"],
        "allowlist": []
