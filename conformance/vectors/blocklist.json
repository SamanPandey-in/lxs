      "request": {
        "method": "GET",
        "target": "/",
        "headers": [],
        "remoteAddress": "2001:db8::7"
      },
      "expect": {
        "outcome": "pass_through"
      }
    },
    {
      "name": "block-mapped-socket",
      "description": "An IPv4-mapped peer matches an IPv4 entry.",
      "config": {
        "mode": "enforce",
