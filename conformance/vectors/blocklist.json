        "headers": [],
        "remoteAddress": "203.0.113.7"
      },
      "expect": {
        "outcome": "blocked",
        "status": 403
      }
    },
    {
      "name": "block-via-trusted-xff",
      "description": "The derived client address is what is checked.",
      "config": {
        "mode": "enforce",
        "trustProxy": 1,
        "allowlist": [],
        "decoys": [
          {
            "id": "web-admin-admin",
            "path": "/admin",
            "prefix": true
          },
          {
            "id": "web-bait-env",
            "path": "/.env",
            "prefix": false
          },
          {
            "id": "web-bait-backup-sql",
            "path": "/backup.sql",
            "prefix": false
          }
        ]
      },
      "policy": {
        "blocklist": ["198.51.100.1"],
        "allowlist": []
      },
      "request": {
        "method": "GET",
        "target": "/",
        "headers": [["x-forwarded-for", "198.51.100.1"]],
        "remoteAddress": "10.0.0.2"
      },
      "expect": {
        "outcome": "blocked",
        "status": 403
      }
    },
    {
      "name": "block-untrusted-xff-cannot-frame",
      "description": "Without trusted proxies, a client cannot get another address blocked.",
      "config": {
        "mode": "enforce",
        "trustProxy": false,
        "allowlist": [],
