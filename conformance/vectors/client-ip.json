{
  "$schema": "../schema/vector.schema.json",
  "category": "client-ip",
  "description": "Deriving the client address: the socket peer unless proxies are trusted; X-Forwarded-For is walked from the right and never read past the first untrusted hop. Results are canonical (IPv4-mapped IPv6 becomes IPv4; IPv6 is RFC 5952).",
  "vectors": [
    {
      "name": "ip-no-proxy-ignores-xff",
      "description": "trustProxy false: X-Forwarded-For is ignored.",
      "config": {
        "mode": "enforce",
        "trustProxy": false,
        "allowlist": [],
        "decoys": [
          {
            "id": "web-admin-admin",
            "path": "/admin",
            "prefix": true
          },
          {
            "id": "web-bait-env",
            "path": "/.env",
            "prefix": false
          },
          {
            "id": "web-bait-backup-sql",
            "path": "/backup.sql",
            "prefix": false
          }
        ]
      },
      "policy": {
        "blocklist": [],
        "allowlist": []
      },
      "request": {
        "method": "GET",
        "target": "/.env",
        "headers": [["x-forwarded-for", "198.51.100.1"]],
        "remoteAddress": "203.0.113.7"
      },
      "expect": {
        "outcome": "decoy",
        "decoy": {
          "id": "web-bait-env",
          "clientIp": "203.0.113.7",
          "headers": {
            "x-forwarded-for": "198.51.100.1"
          }
        }
      }
    },
    {
      "name": "ip-hop1",
      "description": "One trusted hop: the rightmost X-Forwarded-For entry is the client.",
      "config": {
        "mode": "enforce",
        "trustProxy": 1,
        "allowlist": [],
        "decoys": [
          {
            "id": "web-admin-admin",
            "path": "/admin",
            "prefix": true
          },
          {
            "id": "web-bait-env",
            "path": "/.env",
            "prefix": false
          },
          {
            "id": "web-bait-backup-sql",
            "path": "/backup.sql",
            "prefix": false
          }
        ]
      },
      "policy": {
        "blocklist": [],
        "allowlist": []
      },
      "request": {
        "method": "GET",
        "target": "/.env",
        "headers": [["x-forwarded-for", "198.51.100.1"]],
        "remoteAddress": "10.0.0.2"
      },
      "expect": {
        "outcome": "decoy",
        "decoy": {
          "id": "web-bait-env",
          "clientIp": "198.51.100.1"
        }
      }
    },
