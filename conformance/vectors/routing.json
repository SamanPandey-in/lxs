      },
      "policy": {
        "blocklist": [],
        "allowlist": []
      },
      "request": {
        "method": "POST",
        "target": "/admin/login",
        "headers": [["content-type", "application/x-www-form-urlencoded"]],
        "remoteAddress": "203.0.113.7",
        "body": "user=admin&pass=admin"
      },
      "expect": {
        "outcome": "decoy",
        "decoy": {
          "id": "web-admin-admin",
          "clientIp": "203.0.113.7",
          "method": "POST",
          "target": "/admin/login",
          "headers": {
            "content-type": "application/x-www-form-urlencoded",
            "content-length": "21"
          }
        }
      }
    },
