    {
      "name": "route-prefix-post-body",
      "description": "Method and body go to the decoy (a login attempt).",
      "config": {
        "mode": "enforce",
        "trustProxy": false,
        "allowlist": [],
        "decoys": [
          {
            "id": "web-admin-admin",
