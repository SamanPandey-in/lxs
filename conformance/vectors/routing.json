{
  "$schema": "../schema/vector.schema.json",
  "category": "routing",
  "description": "Which request targets are routed to a decoy. Matching uses the path only (no query), percent-decoded once, with one trailing slash removed; it is case-sensitive and does not collapse slashes or resolve dot segments.",
  "vectors": [
    {
      "name": "route-exact-bait",
      "description": "An exact web-bait path is proxied to the decoy with its id.",
      "config": {
        "mode": "enforce",
        "trustProxy": false,
        "allowlist": [],
        "decoys": [
          {
            "id": "web-admin-admin",
            "path": "/admin",
            "prefix": true
          },
          {
            "id": "web-bait-env",
            "path": "/.env",
            "prefix": false
          },
          {
            "id": "web-bait-backup-sql",
            "path": "/backup.sql",
            "prefix": false
          }
        ]
      },
      "policy": {
        "blocklist": [],
        "allowlist": []
      },
      "request": {
        "method": "GET",
        "target": "/.env",
        "headers": [],
        "remoteAddress": "203.0.113.7"
      },
      "expect": {
        "outcome": "decoy",
        "decoy": {
          "id": "web-bait-env",
          "clientIp": "203.0.113.7",
          "method": "GET",
          "target": "/.env"
        }
      }
    },
    {
      "name": "route-query-kept",
      "description": "The query string is ignored for matching and forwarded verbatim.",
