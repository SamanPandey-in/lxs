        "headers": [],
        "remoteAddress": "203.0.113.7"
      },
      "expect": {
        "outcome": "decoy",
        "decoy": {
          "id": "web-bait-env",
          "clientIp": "203.0.113.7",
          "target": "/.env?debug=1&x=%2e"
        }
      }
    },
