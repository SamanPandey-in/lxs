        "blocklist": [],
        "allowlist": []
      },
      "request": {
        "method": "GET",
        "target": "/admin/panel",
        "headers": [["cookie", "phpsessid=0123456789abcdefghijklmnop"]],
        "remoteAddress": "203.0.113.7"
      },
      "expect": {
        "outcome": "decoy",
