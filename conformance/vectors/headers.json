        }
      }
    },
    {
      "name": "decoy-body-over-limit",
      "description": "A decoy request declaring more than 65536 body bytes is refused with 413.",
      "config": {
        "mode": "enforce",
        "trustProxy": false,
        "allowlist": [],
        "decoys": [
          {
            "id": "web-admin-admin",
            "path": "/admin",
            "prefix": true
          },
          {
            "id": "web-bait-env",
            "path": "/.env",
            "prefix": false
          },
          {
            "id": "web-bait-backup-sql",
            "path": "/backup.sql",
            "prefix": false
          }
        ]
      },
      "policy": {
        "blocklist": [],
        "allowlist": []
      },
      "request": {
        "method": "POST",
        "target": "/admin/login",
        "headers": [],
        "remoteAddress": "203.0.113.7",
        "bodyBytes": 65537
      },
      "expect": {
        "outcome": "blocked",
        "status": 413
      }
    },
    {
      "name": "decoy-body-at-limit",
      "description": "A 65536-byte body is still proxied.",
      "config": {
        "mode": "enforce",
        "trustProxy": false,
