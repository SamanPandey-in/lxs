{
  "$schema": "../schema/vector.schema.json",
  "category": "headers",
  "description": "What the app and the decoy see: x-ds-* is ours (client copies are always removed), real users' credentials never reach a decoy, and only a well-formed decoy session cookie is forwarded.",
  "vectors": [
    {
      "name": "decoy-replaces-client-ds-headers",
      "description": "Client-supplied x-ds-* headers are dropped; the middleware sets its own.",
      "config": {
        "mode": "enforce",
        "trustProxy": false,
        "allowlist": [],
        "decoys": [
          {
            "id": "web-admin-admin",
            "path": "/admin",
            "prefix": true
          },
          {
            "id": "web-bait-env",
            "path": "/.env",
            "prefix": false
          },
          {
            "id": "web-bait-backup-sql",
            "path": "/backup.sql",
            "prefix": false
          }
        ]
      },
      "policy": {
        "blocklist": [],
        "allowlist": []
      },
      "request": {
        "method": "GET",
        "target": "/.env",
        "headers": [
          ["X-DS-Client-IP", "6.6.6.6"],
          ["x-ds-decoy-id", "forged"],
          ["x-ds-request-id", "forged"],
          ["X-Ds-Anything", "1"]
        ],
        "remoteAddress": "203.0.113.7"
      },
      "expect": {
        "outcome": "decoy",
        "decoy": {
          "id": "web-bait-env",
          "clientIp": "203.0.113.7",
          "headers": {
            "x-ds-request-id": true,
            "x-ds-anything": null
          }
        }
      }
    },
    {
      "name": "pass-strips-ds-headers",
      "description": "The app never sees client-supplied x-ds-* headers; other headers are untouched.",
      "config": {
        "mode": "enforce",
        "trustProxy": false,
        "allowlist": [],
        "decoys": [
          {
            "id": "web-admin-admin",
            "path": "/admin",
            "prefix": true
          },
          {
            "id": "web-bait-env",
            "path": "/.env",
            "prefix": false
          },
          {
            "id": "web-bait-backup-sql",
            "path": "/backup.sql",
            "prefix": false
          }
        ]
      },
      "policy": {
        "blocklist": [],
        "allowlist": []
      },
      "request": {
        "method": "GET",
        "target": "/api/products",
        "headers": [
          ["x-ds-client-ip", "6.6.6.6"],
          ["X-DS-Decoy-Id", "forged"],
          ["x-ds-sim-ip", "6.6.6.6"],
          ["x-request-id", "abc"]
        ],
        "remoteAddress": "203.0.113.7"
      },
      "expect": {
        "outcome": "pass_through",
        "app": {
          "headers": {
            "x-ds-client-ip": null,
            "x-ds-decoy-id": null,
            "x-ds-sim-ip": null,
            "x-request-id": "abc"
          }
        }
      }
    },
    {
      "name": "pass-keeps-credentials",
      "description": "Pass-through requests keep Cookie and Authorization (they are the app's).",
      "config": {
        "mode": "enforce",
        "trustProxy": false,
        "allowlist": [],
        "decoys": [
          {
            "id": "web-admin-admin",
            "path": "/admin",
            "prefix": true
          },
          {
            "id": "web-bait-env",
            "path": "/.env",
            "prefix": false
          },
          {
            "id": "web-bait-backup-sql",
            "path": "/backup.sql",
            "prefix": false
          }
        ]
      },
      "policy": {
        "blocklist": [],
        "allowlist": []
      },
      "request": {
        "method": "GET",
        "target": "/api/me",
        "headers": [["cookie", "sid=SECRET"], ["authorization", "Bearer REAL"]],
        "remoteAddress": "203.0.113.7"
      },
      "expect": {
        "outcome": "pass_through",
        "app": {
          "headers": {
            "cookie": "sid=SECRET",
            "authorization": "Bearer REAL"
          }
        }
      }
    },
    {
      "name": "decoy-strips-credentials",
      "description": "Cookie, Authorization and Proxy-Authorization never reach a decoy.",
      "config": {
        "mode": "enforce",
        "trustProxy": false,
        "allowlist": [],
        "decoys": [
          {
            "id": "web-admin-admin",
            "path": "/admin",
            "prefix": true
          },
          {
            "id": "web-bait-env",
            "path": "/.env",
            "prefix": false
          },
          {
            "id": "web-bait-backup-sql",
            "path": "/backup.sql",
            "prefix": false
          }
        ]
      },
      "policy": {
        "blocklist": [],
        "allowlist": []
      },
      "request": {
        "method": "GET",
        "target": "/admin",
        "headers": [
          ["cookie", "sid=SECRET"],
          ["authorization", "Bearer REAL"],
          ["proxy-authorization", "Basic eDp5"]
        ],
        "remoteAddress": "203.0.113.7"
      },
      "expect": {
        "outcome": "decoy",
        "decoy": {
          "id": "web-admin-admin",
          "clientIp": "203.0.113.7",
          "headers": {
            "cookie": null,
            "authorization": null,
            "proxy-authorization": null
          }
        }
      }
    },
    {
      "name": "decoy-strips-hop-by-hop",
      "description": "Hop-by-hop request headers are not forwarded.",
      "config": {
        "mode": "enforce",
        "trustProxy": false,
        "allowlist": [],
        "decoys": [
          {
            "id": "web-admin-admin",
            "path": "/admin",
            "prefix": true
          },
          {
            "id": "web-bait-env",
            "path": "/.env",
            "prefix": false
          },
          {
            "id": "web-bait-backup-sql",
            "path": "/backup.sql",
            "prefix": false
          }
        ]
      },
      "policy": {
        "blocklist": [],
        "allowlist": []
      },
      "request": {
        "method": "GET",
        "target": "/.env",
        "headers": [["keep-alive", "timeout=5"], ["te", "trailers"], ["trailer", "x-foo"]],
        "remoteAddress": "203.0.113.7"
      },
      "expect": {
        "outcome": "decoy",
        "decoy": {
          "id": "web-bait-env",
          "clientIp": "203.0.113.7",
          "headers": {
            "keep-alive": null,
            "te": null,
            "trailer": null
          }
        }
      }
    },
    {
      "name": "decoy-forwards-ordinary-headers",
      "description": "End-to-end headers reach the decoy unchanged.",
      "config": {
        "mode": "enforce",
        "trustProxy": false,
        "allowlist": [],
        "decoys": [
          {
            "id": "web-admin-admin",
            "path": "/admin",
            "prefix": true
          },
          {
            "id": "web-bait-env",
            "path": "/.env",
            "prefix": false
          },
          {
            "id": "web-bait-backup-sql",
            "path": "/backup.sql",
            "prefix": false
          }
        ]
      },
      "policy": {
        "blocklist": [],
        "allowlist": []
      },
      "request": {
        "method": "GET",
        "target": "/.env",
        "headers": [["user-agent", "sqlmap/1.7"], ["accept", "*/*"], ["x-custom", "v"]],
        "remoteAddress": "203.0.113.7"
      },
      "expect": {
        "outcome": "decoy",
        "decoy": {
          "id": "web-bait-env",
          "clientIp": "203.0.113.7",
          "headers": {
            "user-agent": "sqlmap/1.7",
            "accept": "*/*",
            "x-custom": "v"
          }
        }
      }
    },
    {
      "name": "cookie-decoy-session-forwarded",
      "description": "A well-formed PHPSESSID (26 chars of [0-9a-v]) is the only cookie forwarded.",
      "config": {
        "mode": "enforce",
        "trustProxy": false,
        "allowlist": [],
        "decoys": [
          {
            "id": "web-admin-admin",
            "path": "/admin",
            "prefix": true
          },
          {
            "id": "web-bait-env",
            "path": "/.env",
            "prefix": false
          },
          {
            "id": "web-bait-backup-sql",
            "path": "/backup.sql",
            "prefix": false
          }
        ]
      },
      "policy": {
        "blocklist": [],
        "allowlist": []
      },
      "request": {
        "method": "GET",
        "target": "/admin/panel",
        "headers": [["cookie", "sid=SECRET; PHPSESSID=0123456789abcdefghijklmnop; theme=dark"]],
        "remoteAddress": "203.0.113.7"
      },
      "expect": {
        "outcome": "decoy",
        "decoy": {
          "id": "web-admin-admin",
          "clientIp": "203.0.113.7",
          "headers": {
            "cookie": "PHPSESSID=0123456789abcdefghijklmnop"
          }
        }
      }
    },
    {
      "name": "cookie-decoy-session-bad-format",
      "description": "A PHPSESSID outside the decoy's format is dropped.",
      "config": {
        "mode": "enforce",
        "trustProxy": false,
        "allowlist": [],
        "decoys": [
          {
            "id": "web-admin-admin",
            "path": "/admin",
            "prefix": true
          },
          {
            "id": "web-bait-env",
