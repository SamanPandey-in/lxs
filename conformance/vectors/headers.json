      },
      "policy": {
        "blocklist": [],
        "allowlist": []
      },
      "request": {
        "method": "GET",
        "target": "/admin/panel",
        "headers": [["cookie", "PHPSESSID=0123456789abcdefghijklmnoz"]],
        "remoteAddress": "203.0.113.7"
      },
      "expect": {
        "outcome": "decoy",
        "decoy": {
          "id": "web-admin-admin",
