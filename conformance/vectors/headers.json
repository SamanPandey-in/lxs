          "headers": {
            "cookie": null
          }
        }
      }
    },
    {
      "name": "cookie-decoy-session-name-case",
      "description": "The cookie name is case-sensitive.",
      "config": {
        "mode": "enforce",
        "trustProxy": false,
        "allowlist": [],
        "decoys": [
          {
            "id": "web-admin-admin",
            "path": "/admin",
            "prefix": true
          },
          {
            "id": "web-bait-env",
