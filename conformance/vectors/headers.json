            "prefix": false
          },
          {
            "id": "web-bait-backup-sql",
            "path": "/backup.sql",
            "prefix": false
          }
        ]
      },
      "policy": {
        "blocklist": [],
        "allowlist": []
      },
      "request": {
        "method": "GET",
        "target": "/admin/panel",
        "headers": [["cookie", "PHPSESSID=../../etc; PHPSESSID=0123456789abcdefghijklmnop"]],
        "remoteAddress": "203.0.113.7"
      },
      "expect": {
        "outcome": "decoy",
        "decoy": {
          "id": "web-admin-admin",
