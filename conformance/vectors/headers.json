            "cookie": null
          }
        }
      }
    },
    {
      "name": "cookie-decoy-session-first-valid",
      "description": "The first well-formed PHPSESSID wins; malformed ones are skipped.",
      "config": {
        "mode": "enforce",
        "trustProxy": false,
        "allowlist": [],
