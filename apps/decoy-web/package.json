{
  "name": "@lxs/decoy-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ds-web: static HTTP decoys served over a Unix socket only. No network, no child processes, logs are the only output.",
  "main": "./src/main.ts",
  "scripts": {
    "build": "tsup",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --import tsx test/*.test.ts"
  },
  "dependencies": {
    "fastify": "^5.6.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.6",
    "typescript": "5.9.3"
  }
}
