# =============================================================================
# LXS - environment template.  Copy to `.env` and adjust.
#   cp .env.example .env
# The API loads ../../.env automatically in `pnpm --filter @lxs/api dev|db:*`.
# =============================================================================

# --- Well-known DEV ingest key (created by `pnpm db:seed`) -------------------
# Lets the agent / simulator connect before real auth exists. DEV ONLY - never use outside local/demo.
#   LXS_INGEST_KEY=ds_dev_0000000000000000000000000000000000000000
# Seeded login:  demo@lxs.dev / demo1234     Seeded project slug: acme-shop (environment=demo)
LXS_INGEST_KEY=ds_dev_0000000000000000000000000000000000000000
LXS_API_URL=http://localhost:8080

# --- Process role -------------------------------------------------------------
# api    = HTTP only          worker = queue consumers + schedulers only
# all    = both in one process (default; fine for the MVP / a single VM)
ROLE=all
NODE_ENV=development
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=info

# --- PostgreSQL 16 (docker compose: infra/platform/docker-compose.platform.yml) -
POSTGRES_USER=lxs
POSTGRES_PASSWORD=lxs
POSTGRES_DB=lxs
POSTGRES_PORT=5432
DATABASE_URL=postgres://lxs:lxs@localhost:5432/lxs

# --- Sessions / browser access -------------------------------------------------
# HMAC secret for the session cookie (>= 16 chars). MUST be changed in production (the API refuses to boot otherwise).
SESSION_SECRET=dev-only-session-secret-change-me
SESSION_TTL_HOURS=168
# Set true when served over HTTPS (Secure cookie flag).
COOKIE_SECURE=false
# Comma-separated browser origins allowed by CORS and by the CSRF Origin check on mutations.
CORS_ORIGINS=http://localhost:3000,http://localhost:3010,http://localhost:5173
# Public base URL of the API (also accepted as an allowed Origin).
PUBLIC_URL=http://localhost:8080
# DEV CONVENIENCE: when true, requests without a session act as the oldest user (the seeded demo user),
# so a dashboard can talk to the API without a login screen. NEVER enable in production.
DEV_AUTH_BYPASS=false

# --- Limits ---------------------------------------------------------------------
# Requests per minute per ingest key on /v1/ingest and /v1/agent/*
INGEST_RATE_PER_MIN=1200
INGEST_PROJECT_EVENTS_PER_MIN=100000
INGEST_PROJECT_BYTES_PER_MIN=268435456
INGEST_SENSOR_EVENTS_PER_MIN=20000
INGEST_SENSOR_BYTES_PER_MIN=67108864
# Requests per minute per client IP on everything else
API_RATE_PER_MIN=1200
# Max request body in bytes (also caps the *decompressed* size x8 for gzip)
MAX_BODY_BYTES=2097152

# --- Demo ---------------------------------------------------------------------
# Allow POST /v1/projects/:pid/demo/replay on any project (otherwise only environment=demo|dev).
DEMO_MODE=true
# Optional override for the common-credentials wordlist used by detection (default: data/wordlists/common-creds.txt)
# COMMON_CREDS_PATH=./data/wordlists/common-creds.txt

# --- Optional (not needed to boot) ------------------------------------------------
# LLM narrator: writes the AI summary and precautions for each incident. Every incident gets a deterministic
# template summary at once; the LLM replaces it a few seconds later, and any failure leaves the template.
# A key starting with "mock-" counts as no key: nothing is sent anywhere. Replace it to turn the LLM on.
LLM_PROVIDER=anthropic
LLM_API_KEY=mock-llm-api-key-replace-me
# Defaults to claude-opus-5-5 on anthropic. Required when LLM_PROVIDER=openai (any OpenAI-compatible API).
# LLM_MODEL=
# LLM_BASE_URL=
# LLM_TIMEOUT_MS=20000
# Provider calls per project per UTC day; past it, incidents keep the template.
# LLM_DAILY_CAP=200
# Seconds to let a burst of events settle before narrating.
# LLM_DEBOUNCE_SECONDS=15

# --- Reverse proxy (docker compose --profile proxy) -------------------------------
# SITE_ADDRESS=localhost
# API_PORT=8080
